{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		// @types/qrcode's type declarations reference HTMLCanvasElement for an (unused) canvas
		// overload, but this project is Node-only with no DOM in lib, so that declaration alone
		// throws a type error — it's a third-party .d.ts issue, not our code, so it's worked around
		// with skipLibCheck (the API we actually use has nothing to do with canvas).
		"skipLibCheck": true
	}
}
